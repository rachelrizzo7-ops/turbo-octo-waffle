# Postgres connection string, e.g. postgresql://user:password@localhost:5432/closet_ai
DATABASE_URL=

# Secret used to sign auth JWTs — use a long random string in real deployments
JWT_SECRET=

# Anthropic API key used for garment classification and outfit recommendations
ANTHROPIC_API_KEY=

# Optional overrides
CLAUDE_MODEL=claude-sonnet-5
PORT=4000
